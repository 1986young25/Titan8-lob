{
  "entities": {
    "TelemetryEvent": {
      "title": "TelemetryEvent",
      "description": "Atomic telemetry log and cryptographic state seal generated by the sovereign tactical command.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "timestamp": {
          "type": "string",
          "maxLength": 64
        },
        "source": {
          "type": "string",
          "maxLength": 64
        },
        "type": {
          "type": "string",
          "maxLength": 64
        },
        "message": {
          "type": "string",
          "maxLength": 512
        },
        "entropy": {
          "type": "number"
        },
        "attenuationDb": {
          "type": "number"
        },
        "sealHash": {
          "type": "string",
          "maxLength": 128
        },
        "operatorUid": {
          "type": "string",
          "maxLength": 128
        },
        "operatorName": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": ["timestamp", "source", "type", "message", "operatorUid"]
    },
    "SystemState": {
      "title": "SystemState",
      "description": "Global tactical parameters, physical constants, and sovereign enclave state configuration.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "maxLength": 64
        },
        "atomicRoot": {
          "type": "string",
          "maxLength": 128
        },
        "metronomeHz": {
          "type": "number"
        },
        "freeSpaceZ0": {
          "type": "number"
        },
        "entropyH": {
          "type": "number"
        },
        "atrmDb": {
          "type": "number"
        },
        "manifoldM": {
          "type": "number"
        },
        "collateralParity": {
          "type": "string",
          "maxLength": 64
        },
        "powSieveOps": {
          "type": "number"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        },
        "lastOperatorUid": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": ["status", "atomicRoot", "metronomeHz", "updatedAt"]
    },
    "LobeConfig": {
      "title": "LobeConfig",
      "description": "Operational tactical overrides and directives for an individual lobe.",
      "type": "object",
      "properties": {
        "lobeIndex": {
          "type": "number"
        },
        "name": {
          "type": "string",
          "maxLength": 128
        },
        "tag": {
          "type": "string",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "maxLength": 32
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "targetFreq": {
          "type": "number"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        },
        "operatorUid": {
          "type": "string",
          "maxLength": 128
        }
      },
      "required": ["lobeIndex", "name", "tag", "status"]
    }
  },
  "firestore": {
    "/telemetry_events/{eventId}": {
      "schema": "TelemetryEvent",
      "description": "Immutable telemetry log entries generated by operators or system pulse ticks."
    },
    "/system_state/{stateId}": {
      "schema": "SystemState",
      "description": "Global enclave operating telemetry and physical constants baseline."
    },
    "/lobe_configs/{lobeId}": {
      "schema": "LobeConfig",
      "description": "Individual lobe operational overrides and tactical directives."
    }
  }
}
